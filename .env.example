# Server
PORT=4000
NODE_ENV=development
# Comma-separated. In production, put BOTH your Vercel production
# domain and, if you want previews to work too, the preview domain,
# e.g.:
# CLIENT_ORIGIN=https://escrit.vercel.app,https://escrit-git-main-you.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Mongo
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/escrit

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Paystack (test keys during the hackathon)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Escrow
AUTO_RELEASE_HOURS=72

# Internal admin surface (manual dispute resolution). Comma-separated
# list of seller emails allowed to hit /api/admin/*. Leave empty to
# deny everyone (fails closed) - set this to your own seller account's
# email before the demo so you can resolve a dispute live.
ADMIN_EMAILS=you@example.com

# Google Sign-In. Only the Client ID is needed here — it's the public
# half of the credential and is also sent to the browser (as
# VITE_GOOGLE_CLIENT_ID in the client's .env). There is no Client
# Secret anywhere in this app: the browser gets a signed ID token
# straight from Google, and the server only verifies it against this
# same Client ID. Create one at https://console.cloud.google.com/apis/credentials
# ("OAuth client ID" -> "Web application"), with your client origin(s)
# added under "Authorized JavaScript origins". Leave blank to disable
# the Google Sign-In button.
GOOGLE_CLIENT_ID=

# Base URL of the deployed client, used to build the link inside
# password-reset emails. Defaults to the first CLIENT_ORIGIN above if
# unset.
CLIENT_URL=

   BREVO_API_KEY=xkeysib-...
   BREVO_FROM_ADDRESS=your-verified-sender@example.com
   BREVO_FROM_NAME=Escrit

# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your16charapppassword
# SMTP_FROM_ADDRESS=Escrit <youraddress@gmail.com>
